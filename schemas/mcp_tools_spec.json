{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relic.dev/schemas/mcp_tools_spec.json",
  "title": "RELIC_MCP_Tools_Specification",
  "description": "Especificación de las 8 herramientas expuestas por `relic_mcp` bajo custodia de `BlackwallGate` (JSON-RPC 2.0 sobre stdio, revisión 2025-03-26).",
  "type": "object",
  "required": ["protocol_version", "tools"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "2025-03-26"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "relic_interpret",
              "relic_verify",
              "relic_retrieve",
              "relic_propose",
              "relic_rollback",
              "relic_consolidate",
              "relic_activate",
              "relic_diff"
            ]
          },
          "description": { "type": "string" },
          "inputSchema": { "type": "object" }
        }
      }
    }
  }
}
